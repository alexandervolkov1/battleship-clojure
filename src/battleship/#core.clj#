(ns battleship.core)

;; constants

(def board-size 10)

(def fleet-spec
  [4 3 3 2 2 2 1 1 1 1])

(defn valid-coordinate? [[x y]]
  (and (<= 0 x (dec board-size))
       (<= 0 y (dec board-size))))

(defn ship-cells [[x y] length orientation]
  (set
    (map (fn [offset]
           (case orientation
             :horizontal [(+ x offset) y]
             :vertical   [x (+ y offset)]))
         (range length))))

(defn valid-ship? [cells]
  (every? valid-coordinate? cells))

(defn neighbor-cells [[x y]]
  (set
   (for [dx [-1 0 1]
         dy [-1 0 1]]
     [(+ x dx) (+ y dy)])))

(defn ship-neighborhood [cells]
  (set
   (mapcat neighbor-cells cells)))

(defn can-place-ship? [new-cells existing-cells]
  (and
   (valid-ship? new-cells)
   (not-any? #(contains? (ship-neighborhood existing-cells) %)
             new-cells)))

(defn fleet-cells [fleet]
  (set (mapcat :cells fleet)))


